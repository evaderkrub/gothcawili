+package mesh
+
+import (
+	"github.com/gopacket/gopacket/layers"
+	"testing"
+)
+
+func TestRadioTapMetadata(t *testing.T) {
+	for _, freq := range []layers.RadioTapChannelFrequency{2412, 5180, 5745} {
+		r := &layers.RadioTap{RadioTapValues: []layers.RadioTapNamespace{{ChannelFrequency: freq, DBMAntennaSignal: -47}}}
+		if channelFromRadioTap(r) != int(freq) || dbmFromRadioTap(r) != -47 {
+			t.Fatal("lost typed radio metadata")
+		}
+	}
+	if channelFromRadioTap(nil) != 0 || dbmFromRadioTap(&layers.RadioTap{}) != 0 {
+		t.Fatal("empty metadata")
+	}
+}
