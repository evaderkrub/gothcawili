@@ -0,0 +1,39 @@
+package wifi
+
+import (
+	"encoding/binary"
+	"github.com/gopacket/gopacket"
+	"github.com/gopacket/gopacket/layers"
+	"net"
+	"testing"
+)
+
+func TestPackRadiotapAndPayload(t *testing.T) {
+	payload := []byte(`{"name":"SIMULATION"}`)
+	err, raw := Pack(net.HardwareAddr{2, 0, 0, 0, 0, 1}, net.HardwareAddr{255, 255, 255, 255, 255, 255}, payload, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := binary.LittleEndian.Uint16(raw[2:4]); n < 8 {
+		t.Fatalf("invalid radiotap length %d", n)
+	}
+	packet := gopacket.NewPacket(raw, layers.LayerTypeRadioTap, gopacket.Default)
+	if e := packet.ErrorLayer(); e != nil {
+		t.Fatal(e.Error())
+	}
+	radio := packet.Layer(layers.LayerTypeRadioTap).(*layers.RadioTap)
+	if radio.RadioTapValues[0].Flags.FCS() {
+		t.Fatal("TX must leave FCS generation to the driver")
+	}
+	dot := packet.Layer(layers.LayerTypeDot11).(*layers.Dot11)
+	if !dot.ChecksumValid() {
+		t.Fatal("invalid FCS")
+	}
+	err, decoded := Unpack(packet, radio, dot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(decoded) != string(payload) {
+		t.Fatalf("payload mismatch %q", decoded)
+	}
+}
